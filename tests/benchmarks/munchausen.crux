

var max = 440000000;

var cache = [0];

for var i = 1; i < 10; i += 1 {
    cache.push(i**i);
}

fn is_munchausen(number: Int) -> Bool {
    var n = number;
    var total = 0;

    while n > 0 {
        total += cache[n % 10];
        if total > number {
            return false;
        }
        n = n \ 10;
    }
    return total == number;
}

fn main() -> Nil {
    for var i = 0; i < max; i += 1 {
        if is_munchausen(i) {
            println(i);
        }
    }
}

main();
